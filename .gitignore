# build.sh emits GuzoFit.html and then copies it to index.html. The two are
# byte-identical by construction, so only the deployed name is tracked —
# committing both would put a second copy of a 490 KB file in every commit
# that touches the build. Run ./build.sh to produce it.
GuzoFit.html

# Playwright, for the test instruments. No trailing slash — a symlinked
# node_modules is not a directory as far as gitignore is concerned.
node_modules
package-lock.json

# Cloudflare's publish directory. build.sh regenerates it; committing it would
# put a second copy of a 500 KB file in every build commit.
dist/
